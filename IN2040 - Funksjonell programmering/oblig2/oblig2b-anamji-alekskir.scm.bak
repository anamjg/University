(define (cycle? lst)
  (define (is-cyc lst1 lst2)
    (cond
      ((null? lst2) #f)
      ((null? (cdr lst2)) #f)
      ((eq? lst1 lst2) #t)
      (else (is-cyc (cdr lst1) (cddr lst2)))))
  (is-cyc lst (cdr lst)))

;; Kjøreeksempler
(cycle? '(hey ho)) ;; -> #f
(cycle? '(la la la)) ;; -> #f
(cycle? bah) ;; -> #f
(cycle? bar) ;; -> #t 

